# ============================================================
#  知识库 Agent 配置模板
#  1) 复制成 .env
#  2) 不填密钥也能跑：离线假模型 + 工具照常工作
#  3) 运行 python run_cli.py --check
# ============================================================

# ---------- 模型接入 ----------
AGENT_API_KEY=
AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENT_MODEL=qwen-plus

# ---------- 运行策略 ----------
AGENT_TEMPERATURE=0.2
AGENT_MAX_TOKENS=1500
AGENT_MAX_STEPS=8
AGENT_TIMEOUT=120
AGENT_MAX_RETRIES=2
AGENT_CONTEXT_BUDGET=24000
# AGENT_ENABLE_THINKING=false

# ---------- 路径 ----------
# 采集 Agent 的来源卡目录（预处理从这里读）
COLLECTOR_SOURCES_DIR=research-collector-agent/sources
# 知识库根目录（内含 staging/frozen/archive/registry.jsonl）
KB_DIR=knowledge_base

AGENT_SAVE_TRACE=true