# ============================================================
#  生成 Agent 配置模板
#  1) 复制成 .env
#  2) 不填密钥也能跑：离线假模型只验证编排
#  3) 运行 python run_cli.py --check
# ============================================================

# ---------- 模型接入 ----------
AGENT_API_KEY=
AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENT_MODEL=qwen-plus

# ---------- 运行策略 ----------
AGENT_TEMPERATURE=0.3
AGENT_MAX_TOKENS=2500
AGENT_MAX_STEPS=8
AGENT_TIMEOUT=120
AGENT_MAX_RETRIES=2
AGENT_CONTEXT_BUDGET=32000
# AGENT_ENABLE_THINKING=false

# ---------- 双源路径（相对项目根，只读） ----------
# 固化基线来自知识库 Agent；来源卡来自采集 Agent。缺任何一路都会拒绝生成。
KB_FROZEN_DIR=knowledge-agent/knowledge_base/frozen
KB_REGISTRY=knowledge-agent/knowledge_base/registry.jsonl
COLLECTOR_SOURCES_DIR=research-collector-agent/sources

AGENT_SAVE_TRACE=true