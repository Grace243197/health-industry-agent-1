# ============================================================
#  调度 Agent 配置模板
#  1) 复制成 .env
#  2) 不填密钥也能跑：离线假模型按关键词路由
#  3) 运行 python run_cli.py --check
# ============================================================

# ---------- 模型接入 ----------
AGENT_API_KEY=
AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENT_MODEL=qwen-plus

# ---------- 运行策略 ----------
AGENT_TEMPERATURE=0.2
AGENT_MAX_TOKENS=2000
# 含一次回退，步数要给够
AGENT_MAX_STEPS=10
# 下游调用超时（比下游自身更宽松）
AGENT_TIMEOUT=180
AGENT_MAX_RETRIES=2
AGENT_CONTEXT_BUDGET=32000
# AGENT_ENABLE_THINKING=false

# ---------- 下游入口（相对项目根） ----------
COLLECTOR_RUN_CLI=research-collector-agent/run_cli.py
KNOWLEDGE_RUN_CLI=knowledge-agent/run_cli.py
GENERATOR_RUN_CLI=generator-agent/run_cli.py
VERIFIER_RUN_CLI=verify-agent/run_cli.py

AGENT_SAVE_TRACE=true