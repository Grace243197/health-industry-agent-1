# ============================================================
#  采集 Agent 配置模板
#  1) 复制成 .env
#  2) 至少确认 SEARCH_BACKEND；要用真实模型再填 AGENT_API_KEY
#  3) 运行 python run_cli.py --check
# ============================================================

# ---------- 必填：模型接入 ----------
# 不填也能跑：自动进入离线假模型，只验证编排链路
AGENT_API_KEY=
AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 采集任务量大，用最便宜那档；以控制台实际模型 ID 为准
AGENT_MODEL=qwen-flash

# ---------- 检索后端 ----------
# free  = PubMed / Europe PMC / OpenAlex / Wikipedia，零 key、零费用（推荐先用这个）
# qwen  = 千问 enable_search，需 DASHSCOPE_API_KEY；只用来发现候选 URL
# both  = 两路合并，按 URL 去重，便于 A/B 对比
SEARCH_BACKEND=free
SEARCH_TIMEOUT=25

# ---------- 运行策略 ----------
AGENT_TEMPERATURE=0.2
AGENT_MAX_TOKENS=1500
AGENT_MAX_STEPS=8
AGENT_TIMEOUT=120
AGENT_MAX_RETRIES=2
AGENT_CONTEXT_BUDGET=24000
# 工具型 Agent 建议关闭深度思考，省时省钱
# AGENT_ENABLE_THINKING=false

# ---------- 目录（默认即可） ----------
# AGENT_WORKSPACE=sources
# AGENT_TRACE_DIR=traces
AGENT_SAVE_TRACE=true